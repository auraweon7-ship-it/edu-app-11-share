# .env 로 복사한 뒤 값을 채우세요 (.env 는 git 에 올라가지 않습니다)

# Postgres 접속 문자열
DATABASE_URL=postgres://사용자:비밀번호@localhost:5432/edu_app_share

# 원격 DB가 SSL을 요구하면 true
DATABASE_SSL=false

# 대시보드에서 히스토리를 조회할 때 입력하는 관리자 키 (길고 추측하기 어렵게)
ADMIN_KEY=change-me

# 서버 포트
PORT=8080

# 프론트를 다른 도메인(예: GitHub Pages)에서 열 때 허용할 Origin, 쉼표로 여러 개
# 예: https://auraweon7-ship-it.github.io
ALLOWED_ORIGIN=
